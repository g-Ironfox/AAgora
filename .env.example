# ============================================================
# 环境变量模板:复制为 .env 后按需填写。
# 当前 webui 实际消费的环境变量仅 MONGO_* 与可选的 MONGO_URI,
# 旧项目变量(DEEPSEEK_* / KIMI_* / QQ_* / REDIS_* / AGENT_* 等)已清理;
# 接入 AI / Agent / 队列等功能时再补回对应变量。
# ============================================================

MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_USER=aagora
MONGO_PASS=replace-with-a-strong-password
MONGO_DATABASE=aagora

# 可选:直接指定完整连接串(设置后忽略上方 MONGO_HOST / PORT / USER / PASS)
# MONGO_URI=mongodb://user:pass@host:27017/?authSource=admin